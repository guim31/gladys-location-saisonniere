{
  "manifest_version": 1,
  "type": "device",
  "name": "Holiday rental (iCal)",
  "description": {
    "en": "Guest check-ins and check-outs from Airbnb, Booking.com or Vrbo iCal exports: preheat, cleaning.",
    "fr": "Arrivées et départs des voyageurs depuis les iCal Airbnb, Booking.com, Abritel : préchauffe, ménage.",
    "de": "An- und Abreisen der Gäste aus iCal-Exporten von Airbnb, Booking.com, Vrbo: Vorheizen, Reinigung.",
    "es": "Llegadas y salidas de huéspedes desde los iCal de Airbnb, Booking.com o Vrbo: precalentar, limpieza."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-location-saisonniere:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-location-saisonniere/main/cover.png",
  "categories": ["services"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your rental properties",
        "fr": "Vos logements",
        "de": "Deine Unterkünfte",
        "es": "Sus alojamientos"
      },
      "description": {
        "en": "Up to three properties, each one a device. Paste the iCal export address of its calendar on each platform (Airbnb: Calendar → Availability → Connect calendars; Booking.com: Rates & availability → Sync calendars). Private addresses: they stay in Gladys.",
        "fr": "Jusqu'à trois logements, chacun un appareil. Collez l'adresse d'export iCal de son calendrier sur chaque plateforme (Airbnb : Calendrier → Disponibilités → Connecter des calendriers ; Booking.com : Tarifs et disponibilités → Synchroniser). Adresses privées : elles restent dans Gladys.",
        "de": "Bis zu drei Unterkünfte, jede ein Gerät. Füge die iCal-Exportadresse ihres Kalenders auf jeder Plattform ein (Airbnb: Kalender → Verfügbarkeit → Kalender verbinden; Booking.com: Preise & Verfügbarkeit → Synchronisieren). Private Adressen: sie bleiben in Gladys.",
        "es": "Hasta tres alojamientos, cada uno un dispositivo. Pegue la dirección de exportación iCal de su calendario en cada plataforma (Airbnb: Calendario → Disponibilidad → Conectar calendarios; Booking.com: Tarifas y disponibilidad → Sincronizar). Direcciones privadas: se quedan en Gladys."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-location-saisonniere#readme",
          "label": {
            "en": "Documentation",
            "fr": "Documentation",
            "de": "Dokumentation",
            "es": "Documentación"
          }
        }
      ]
    },
    {
      "key": "property_1_section",
      "type": "section",
      "label": {
        "en": "Property 1",
        "fr": "Logement 1",
        "de": "Unterkunft 1",
        "es": "Alojamiento 1"
      }
    },
    {
      "key": "property_1_name",
      "type": "string",
      "label": {
        "en": "Property 1: name",
        "fr": "Logement 1 : nom",
        "de": "Unterkunft 1: Name",
        "es": "Alojamiento 1: nombre"
      },
      "description": {
        "en": "Name of the device in Gladys.",
        "fr": "Nom de l'appareil dans Gladys.",
        "de": "Name des Geräts in Gladys.",
        "es": "Nombre del dispositivo en Gladys."
      },
      "placeholder": {
        "en": "e.g. Seaside flat",
        "fr": "ex. Appartement de la plage",
        "de": "z. B. Ferienwohnung am Meer",
        "es": "p. ej. Piso de la playa"
      },
      "required": false
    },
    {
      "key": "property_1_url_1",
      "type": "secret",
      "label": {
        "en": "Property 1: iCal address",
        "fr": "Logement 1 : adresse iCal",
        "de": "Unterkunft 1: iCal-Adresse",
        "es": "Alojamiento 1: dirección iCal"
      },
      "description": {
        "en": "Export address (.ics) of the property calendar on a platform. Several addresses may be separated by a space.",
        "fr": "Adresse d'export (.ics) du calendrier du logement sur une plateforme. Plusieurs adresses peuvent être séparées par une espace.",
        "de": "Exportadresse (.ics) des Kalenders der Unterkunft auf einer Plattform. Mehrere Adressen lassen sich durch Leerzeichen trennen.",
        "es": "Dirección de exportación (.ics) del calendario del alojamiento en una plataforma. Puede separar varias direcciones con un espacio."
      },
      "required": false
    },
    {
      "key": "property_1_url_2",
      "type": "secret",
      "label": {
        "en": "Property 1: other iCal address",
        "fr": "Logement 1 : autre adresse iCal",
        "de": "Unterkunft 1: weitere iCal-Adresse",
        "es": "Alojamiento 1: otra dirección iCal"
      },
      "description": {
        "en": "The same property on another platform: the stays are merged, the duplicates removed.",
        "fr": "Le même logement sur une autre plateforme : les séjours sont fusionnés, les doublons retirés.",
        "de": "Dieselbe Unterkunft auf einer anderen Plattform: Die Aufenthalte werden zusammengeführt, Doppelte entfernt.",
        "es": "El mismo alojamiento en otra plataforma: las estancias se fusionan y se eliminan los duplicados."
