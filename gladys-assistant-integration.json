      "label": {
        "en": "Options",
        "fr": "Options",
        "de": "Optionen",
        "es": "Opciones"
      }
    },
    {
      "key": "lead_hours",
      "type": "number",
      "label": {
        "en": "Lead time before check-in (hours)",
        "fr": "Anticipation avant l'arrivée (heures)",
        "de": "Vorlauf vor der Anreise (Stunden)",
        "es": "Antelación antes de la llegada (horas)"
      },
      "description": {
        "en": "\"Check-in soon\" turns on, and its scene trigger fires, this many hours before the check-in: time to preheat. 0 turns it off.",
        "fr": "« Arrivée imminente » passe à oui, et son déclencheur de scène part, ce nombre d'heures avant l'arrivée : le temps de préchauffer. 0 le désactive.",
        "de": "„Anreise bald“ geht so viele Stunden vor der Anreise an, und sein Szenen-Auslöser startet: Zeit zum Vorheizen. 0 schaltet es ab.",
        "es": "«Llegada próxima» se activa, y su disparador de escena se lanza, este número de horas antes de la llegada: tiempo para precalentar. 0 lo desactiva."
      },
      "required": false,
      "default": 3,
      "min": 0,
      "max": 72
    },
    {
      "key": "unavailable_events",
      "type": "select",
      "label": {
        "en": "\"Not available\" dates",
        "fr": "Dates « Not available »",
        "de": "„Not available“-Daten",
        "es": "Fechas «Not available»"
      },
      "description": {
        "en": "Booking.com and Smoobu export every booking as \"Not available\", like a closed date. Airbnb and Vrbo blocks are always ignored.",
        "fr": "Booking.com et Smoobu exportent chaque réservation en « Not available », comme une date fermée. Les blocages Airbnb et Vrbo sont toujours ignorés.",
        "de": "Booking.com und Smoobu exportieren jede Buchung als „Not available“, wie ein gesperrtes Datum. Sperren von Airbnb und Vrbo werden immer ignoriert.",
        "es": "Booking.com y Smoobu exportan cada reserva como «Not available», igual que una fecha cerrada. Los bloqueos de Airbnb y Vrbo siempre se ignoran."
      },
      "required": false,
      "default": "stay",
      "options": [
        {
          "value": "stay",
          "label": {
            "en": "Count them as stays",
            "fr": "Les compter comme séjours",
            "de": "Als Aufenthalte zählen",
            "es": "Contarlas como estancias"
          }
        },
        {
          "value": "ignore",
          "label": {
            "en": "Ignore them",
            "fr": "Les ignorer",
            "de": "Ignorieren",
            "es": "Ignorarlas"
          }
        }
      ]
    },
    {
      "key": "show_guest_details",
      "type": "boolean",
      "label": {
        "en": "Show guest names and codes",
        "fr": "Afficher noms et codes des voyageurs",
        "de": "Gastnamen und Codes anzeigen",
        "es": "Mostrar nombres y códigos"
      },
      "description": {
        "en": "Off: the first names and reservation codes some feeds carry stay hidden from the widget and the scenes (personal data).",
        "fr": "Désactivé : les prénoms et codes de réservation de certains flux restent masqués du widget et des scènes (données personnelles).",
        "de": "Aus: Vornamen und Buchungscodes mancher Feeds bleiben in Widget und Szenen verborgen (personenbezogene Daten).",
        "es": "Desactivado: los nombres y códigos de reserva de algunos calendarios quedan ocultos en el widget y las escenas (datos personales)."
      },
      "required": false,
      "default": false
    },
